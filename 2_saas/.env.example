# Copy to .env and fill in. Never commit the real .env file.
FLASK_SECRET=some-random-string
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret

# From the webhook you create in the developer dashboard
PAYPAL_WEBHOOK_ID=your-webhook-id

# Public URL that PayPal can reach (ngrok while developing)
BASE_URL=https://your-ngrok-url.ngrok-free.app

# Printed by setup_plans.py
PLAN_ID_BASIC=
PLAN_ID_PRO=
